// --- Генерація номера замовлення (EE-0001, EE-0002, ...) ---
function generateOrderNumber() {
  var props = PropertiesService.getScriptProperties();
  var counter = parseInt(props.getProperty("orderCounter") || "0") + 1;
  props.setProperty("orderCounter", String(counter));
  return "EE-" + String(counter).padStart(4, "0");
}

