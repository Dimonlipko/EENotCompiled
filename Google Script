var SUPABASE_URL = "https://fkmolbxcicwishbtmqbs.supabase.co";
var SUPABASE_BUCKET = "product";

function getSupabaseKey() {
  return PropertiesService.getScriptProperties().getProperty('SUPABASE_SERVICE_KEY');
}

function supabaseGetProducts() {
  var url = SUPABASE_URL + "/storage/v1/object/public/" + SUPABASE_BUCKET + "/products.json?t=" + Date.now();
  var response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
  if (response.getResponseCode() === 200) {
    return JSON.parse(response.getContentText());
  }
  return [];
}

function supabaseUpdateProducts(products) {
  var key = getSupabaseKey();
  var url = SUPABASE_URL + "/storage/v1/object/" + SUPABASE_BUCKET + "/products.json";
  var json = JSON.stringify(products, null, 2);
  var response = UrlFetchApp.fetch(url, {
    method: "PUT",
    headers: {
      "Authorization": "Bearer " + key,
      "Content-Type": "application/json",
      "x-upsert": "true"
    },
    payload: json,
    muteHttpExceptions: true
  });
  var code = response.getResponseCode();
  if (code !== 200) {
    writeLog("SUPABASE ERROR", "Update failed: " + code + " " + response.getContentText().substring(0, 200));
  }
  return code === 200;
}

function uploadTelegramPhotoToSupabase(fileId, filename) {
  var token = PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');

  // Отримати file_path від Telegram
  var fileInfo = UrlFetchApp.fetch("https://api.telegram.org/bot" + token + "/getFile?file_id=" + fileId);
  var filePath = JSON.parse(fileInfo.getContentText()).result.file_path;

  // Завантажити blob з Telegram
  var fileBlob = UrlFetchApp.fetch("https://api.telegram.org/file/bot" + token + "/" + filePath);
  var bytes = fileBlob.getBlob().getBytes();

  // Завантажити на Supabase Storage
  var url = SUPABASE_URL + "/storage/v1/object/" + SUPABASE_BUCKET + "/images/" + filename;
  var response = UrlFetchApp.fetch(url, {
    method: "PUT",
    headers: {
      "Authorization": "Bearer " + getSupabaseKey(),
      "Content-Type": "image/jpeg",
      "x-upsert": "true"
    },
    payload: bytes,
    muteHttpExceptions: true
  });

  if (response.getResponseCode() === 200) {
    return SUPABASE_URL + "/storage/v1/object/public/" + SUPABASE_BUCKET + "/images/" + filename;
  }
  return null;
}

