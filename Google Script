// Функція для запису в вкладку Logs
function writeLog(level, message) {
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Logs");
    if (sheet) {
      // Додаємо рядок: Час | Рівень | Повідомлення
      sheet.appendRow([new Date(), level, message]);
    } else {
      // Якщо вкладки немає, пишемо в консоль Google
      Logger.log("TAB 'Logs' NOT FOUND! " + level + ": " + message);
    }
  } catch (e) {
    Logger.log("LOGGING FAILED: " + e.toString());
  }
}

function sendTelegramMessage(text) {
  const scriptProps = PropertiesService.getScriptProperties();
  const token = scriptProps.getProperty('TELEGRAM_TOKEN'); 
  const chatId = scriptProps.getProperty('CHAT_ID');

  if (!token || !chatId) {
    writeLog("ERROR", "Telegram token or Chat ID missing");
    return;
  }

  const url = `https://api.telegram.org/bot${token}/sendMessage`;
  const payload = { chat_id: chatId, text: text, parse_mode: "Markdown" };
  const options = { method: "POST", contentType: "application/json", payload: JSON.stringify(payload), muteHttpExceptions: true };

  try {
    var response = UrlFetchApp.fetch(url, options);
    var respCode = response.getResponseCode();
    if (respCode !== 200) {
       writeLog("TELEGRAM ERROR", "Response code: " + respCode + ". Body: " + response.getContentText());
    }
  } catch (error) {
    writeLog("TELEGRAM EXCEPTION", error.toString());
  }
}

