// === CALLBACK QUERY (інлайн кнопки) ===
// ============================================================

function handleCallbackQuery(query) {
  var chatId = String(query.message.chat.id);
  var adminChatId = String(PropertiesService.getScriptProperties().getProperty('CHAT_ID')).trim();
  if (chatId !== adminChatId) return;

  var data = query.data;
  var token = PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');

  UrlFetchApp.fetch("https://api.telegram.org/bot" + token + "/answerCallbackQuery", {
    method: "POST", contentType: "application/json",
    payload: JSON.stringify({ callback_query_id: query.id }), muteHttpExceptions: true
  });

  // --- Головне меню ---
  if (data === "menu_products") return showProductsMenu(chatId);
  if (data === "menu_orders") return showOrdersMenu(chatId);
  if (data === "menu_back") return showMainMenu(chatId);

  // --- Товари: дії ---
  if (data === "cmd_list") return handleList(chatId);
  if (data === "action_add") return startAddProduct(chatId);
  if (data === "action_price") return showProductButtons(chatId, "price");
  if (data === "action_status") return showProductButtons(chatId, "status");
  if (data === "action_photo") return showProductButtons(chatId, "photo");
  if (data === "action_options") return showProductButtons(chatId, "options");
  if (data === "action_delete") return showProductButtons(chatId, "delete");

  // --- Вибір товару для дії ---
  if (data.startsWith("price_")) return startPriceChange(chatId, parseInt(data.split("_")[1]));
  if (data.startsWith("delete_")) return confirmDelete(chatId, parseInt(data.split("_")[1]));
  if (data.startsWith("confirm_del_")) return executeDelete(chatId, parseInt(data.split("_")[2]));
  if (data.startsWith("photo_")) return startAddPhoto(chatId, parseInt(data.split("_")[1]));
  if (data.startsWith("options_")) return startOptionsEdit(chatId, parseInt(data.split("_")[1]));

  // --- Статус товару ---
  if (data.startsWith("status_")) {
    var parts = data.split("_");
    if (parts.length === 2) return showStatusOptions(chatId, parseInt(parts[1]));
    if (parts.length === 3) return setProductStatus(chatId, parseInt(parts[1]), parts[2]);
  }
}

