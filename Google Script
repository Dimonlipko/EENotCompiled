}

// --- Зберегти замовлення в Supabase ---
function saveOrderToSupabase(data, orderNumber, productsInfo) {
  var SUPABASE_URL = "https://fkmolbxcicwishbtmqbs.supabase.co";
  var SUPABASE_KEY = PropertiesService.getScriptProperties().getProperty("SUPABASE_SERVICE_KEY");
  if (!SUPABASE_KEY) {
    writeLog("WARN", "SUPABASE_SERVICE_KEY not set, skipping Supabase save");
    return;
  }

  var payload = {
    order_number: orderNumber,
    name: data.name || "",
    phone: data.phone || "",
    email: data.email || "",
    country: data.country || "",
    delivery: data.delivery || "",
    branch: data.branch || "",
    address: data.address || "",
    payment: data.payment || "",
    total: data.total || 0,
    products: productsInfo,
    products_json: data.products || [],
    ip: data.ip || "",
    status: "new",
    created_at: new Date().toISOString()
  };

  var options = {
    method: "post",
    contentType: "application/json",
    headers: {
      "apikey": SUPABASE_KEY,
      "Authorization": "Bearer " + SUPABASE_KEY,
      "Prefer": "return=minimal"
    },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  };

  var response = UrlFetchApp.fetch(SUPABASE_URL + "/rest/v1/orders", options);
  var code = response.getResponseCode();
  if (code >= 200 && code < 300) {
    writeLog("INFO", "Order #" + orderNumber + " saved to Supabase");
  } else {
    writeLog("WARN", "Supabase response " + code + ": " + response.getContentText());
  }
}

