// === POST — Замовлення, контакти та Telegram webhook ===
function doPost(e) {
  try {
    if (!e.postData || !e.postData.contents) throw new Error("No data received");

    const data = JSON.parse(e.postData.contents);

    // --- TELEGRAM WEBHOOK ---
    if (data.update_id !== undefined) {
      if (data.callback_query) {
        try { handleCallbackQuery(data.callback_query); } catch(ex) {}
      } else if (data.message) {
        try { handleTelegramWebhook(data); } catch(ex) {}
      }
      return HtmlService.createHtmlOutput();
    }

    // --- Замовлення/контакти — з lock і логуванням ---
    var lock = LockService.getScriptLock();
    lock.tryLock(10000);

    var rawData = e.postData.contents;
    writeLog("INFO", "Вхідний запит: " + rawData);

    // --- 🛡️ АНТИ-СПАМ (Honeypot & Time) ---
    if (data.honeypot && data.honeypot.length > 0) {
      writeLog("WARN", "SPAM DETECTED: Honeypot filled. IP: " + (data.ip || "Unknown"));
      return successStub();
    }
    
    // Перевірка часу (якщо прийшло timeTaken)
    if (data.timeTaken && data.timeTaken < 2000) {
      writeLog("WARN", "SPAM DETECTED: Too fast (" + data.timeTaken + "ms). IP: " + (data.ip || "Unknown"));
      return successStub();
    }

    // --- 🛡️ КЕШУВАННЯ (Дублікати) ---
    // Якщо IP немає, використовуємо тільки телефон як ідентифікатор
    const ipLabel = data.ip && data.ip !== 'Unknown' ? data.ip : "NoIP";
    const userIdentifier = (data.phone || "NoPhone") + "_" + ipLabel;
    
    const cache = CacheService.getScriptCache();
    const isDuplicate = cache.get(userIdentifier);
    
    if (isDuplicate) {
      writeLog("WARN", "DUPLICATE BLOCKED: " + userIdentifier);
      return successStub(); 
    }
    
    // Блокуємо повтори на 180 секунд
    cache.put(userIdentifier, "true", 180);

    // --- ВАЛІДАЦІЯ ---
    if (!data.phone || !data.name || data.name.length < 1) {
       writeLog("ERROR", "VALIDATION FAILED: No name or phone");
       return ContentService.createTextOutput(JSON.stringify({status: "error", message: "Invalid data"}))
         .setMimeType(ContentService.MimeType.JSON);
    }

    // Валідація email
    if (data.email && !/^.+@.+\..+$/.test(data.email)) {
      writeLog("WARN", "INVALID EMAIL: " + data.email + " IP: " + (data.ip || "Unknown"));
      return ContentService.createTextOutput(JSON.stringify({status: "error", message: "Invalid email"}))
        .setMimeType(ContentService.MimeType.JSON);
    }

    // Валідація телефону (мінімум 9 цифр)
    var phoneDigits = (data.phone || "").replace(/[^\d]/g, "");
    if (phoneDigits.length < 9) {
      writeLog("WARN", "INVALID PHONE: " + data.phone + " IP: " + (data.ip || "Unknown"));
      return ContentService.createTextOutput(JSON.stringify({status: "error", message: "Invalid phone"}))
        .setMimeType(ContentService.MimeType.JSON);
    }

    // --- 🛡️ RATE LIMIT за IP/добу (макс 5 запитів за 24 години) ---
    if (data.ip && data.ip !== 'Unknown') {
      var rateLimitKey = "rate_" + data.ip;
      var requestCount = cache.get(rateLimitKey);
      var count = requestCount ? parseInt(requestCount) : 0;
      if (count >= 5) {
        writeLog("WARN", "RATE LIMIT EXCEEDED: " + data.ip + " (" + count + " requests)");
        return successStub();
      }
      cache.put(rateLimitKey, String(count + 1), 86400);
    }

    // --- 🛡️ URL-СПАМ ФІЛЬТР (3+ посилань = спам) ---
    var messageText = data.message || "";
    var urlCount = (messageText.match(/https?:\/\//gi) || []).length;
    if (urlCount >= 3) {
      writeLog("WARN", "URL SPAM DETECTED: " + urlCount + " URLs. IP: " + (data.ip || "Unknown"));
      return successStub();
    }

    // --- САНІТИЗАЦІЯ (видалення HTML/script тегів) ---
    if (data.name) data.name = data.name.replace(/<[^>]*>/g, "");
    if (data.message) data.message = data.message.replace(/<[^>]*>/g, "");

    // --- РОЗРІЗНЕННЯ ЗА ТИПОМ ---
    if (data.type === "contact") {
      // === КОНТАКТНЕ ПОВІДОМЛЕННЯ ===
      const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Контакти");
      if (!sheet) throw new Error("Аркуш 'Контакти' не знайдено");

      const newRow = [
        new Date(),
        data.name,
        "'" + (data.phone || ""),
        data.email || "—",
        data.message || "—",
        data.ip || "Не визначено"
      ];

      sheet.appendRow(newRow);
      writeLog("SUCCESS", "Contact saved for: " + data.email);

      const telegramMessage = `📩 *Нове повідомлення!*\n` +
                              `👤 ${data.name}\n📞 ${data.phone}\n` +
                              `✉️ ${data.email || "—"}\n\n` +
                              `💬 ${data.message || "—"}\n` +
                              `📍 IP: ${data.ip || "N/A"}`;

      sendTelegramMessage(telegramMessage);

    } else {
      // === ЗАМОВЛЕННЯ ===
      const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Лист1");
      if (!sheet) throw new Error("Аркуш 'Лист1' не знайдено");

      // --- Генерація номера замовлення ---
      var orderNumber = generateOrderNumber();
      data.orderNumber = orderNumber;

      const productsInfo = data.products ? data.products.map(p => `${p.title} (${p.quantity})`).join("\n") : "";

      const newRow = [
        new Date(),
        orderNumber,
        data.name,
        "'" + (data.phone || ""),
        data.email || "—",
        productsInfo,
        data.country || "—",
        data.delivery || "—",
        data.branch || data.address || "—",
        data.payment || "—",
        data.total || 0,
        data.ip || "Не визначено"
      ];

      sheet.appendRow(newRow);
      writeLog("SUCCESS", "Order #" + orderNumber + " saved for: " + data.email);

      // --- Зберегти в Supabase ---
      try {
        saveOrderToSupabase(data, orderNumber, productsInfo);
      } catch (sbErr) {
        writeLog("WARN", "Supabase save failed: " + sbErr.toString());
      }

      const telegramMessage = `⚡️ *Нове замовлення #${orderNumber}!*\n` +
                              `👤 ${data.name}\n📞 ${data.phone}\n` +
                              `💰 ${data.total} $ (${data.totalUah || '?'} ₴)\n` +
                              `🚚 ${data.delivery || "—"} ${data.branch || data.address || ""}\n` +
                              `💳 ${data.payment || "—"}\n` +
                              `📍 IP: ${data.ip || "N/A"}\n\n` +
                              `🛒 ${productsInfo}`;

      sendTelegramMessage(telegramMessage);

      // --- EMAIL підтвердження клієнту ---
      if (data.email) {
        try {
          var emailSubject = data.country === 'UA'
            ? 'Замовлення #' + orderNumber + ' прийнято — Electric Engines'
            : 'Order #' + orderNumber + ' confirmed — Electric Engines';
          GmailApp.sendEmail(data.email,
            emailSubject,
            '',
            {
              from: 'electricenginescar@gmail.com',
              name: 'Electric Engines',
              htmlBody: buildOrderEmailHtml(data)
            }
          );
          writeLog("INFO", "Confirmation email sent to: " + data.email);
        } catch (emailErr) {
          writeLog("WARN", "Failed to send email to " + data.email + ": " + emailErr.toString());
        }
      }
    }

    return ContentService.createTextOutput(JSON.stringify({
      status: "success",
      orderNumber: data.orderNumber || ""
    })).setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    writeLog("CRITICAL ERROR", error.toString());
    return ContentService.createTextOutput(JSON.stringify({status: "error", message: error.toString()}))
      .setMimeType(ContentService.MimeType.JSON);
  } finally {
    try { lock.releaseLock(); } catch(ex) {}
  }
}

