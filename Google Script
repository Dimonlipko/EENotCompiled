// --- Стейт для діалогів ---
function setBotState(chatId, state) {
  CacheService.getScriptCache().put("bot_" + chatId, JSON.stringify(state), 300);
}
function getBotState(chatId) {
  var raw = CacheService.getScriptCache().get("bot_" + chatId);
  return raw ? JSON.parse(raw) : null;
}
function clearBotState(chatId) {
  CacheService.getScriptCache().remove("bot_" + chatId);
}

// --- Головне меню (фіксовані кнопки внизу) ---
var MAIN_KEYBOARD = {
  keyboard: [
    [{ text: "📦 Товари" }, { text: "📋 Замовлення" }],
    [{ text: "❓ Допомога" }]
  ],
  resize_keyboard: true,
  one_time_keyboard: false
};

function handleTelegramWebhook(update) {
  try {
    const message = update.message;
    if (!message) return successStub();
    if (message.from && message.from.is_bot) return;

    const chatId = String(message.chat.id);
    const adminChatId = String(PropertiesService.getScriptProperties().getProperty('CHAT_ID')).trim();
    if (chatId !== adminChatId) return successStub();

    const text = message.text || message.caption || "";

    // --- Фото: додати товар або додати фото до існуючого ---
    if (message.photo && message.photo.length > 0) {
      var state = getBotState(chatId);
      if (state && state.action === "awaiting_photo") {
        return handleAddPhotoByState(chatId, message, state);
      }
      if (state && state.action === "awaiting_new_product_photo") {
        return handleNewProductPhoto(chatId, message, state);
      }
      // Старий формат: фото + підпис
      var caption = message.caption || "";
      if (caption.startsWith("/addphoto")) return handleAddPhoto(chatId, message, caption);
      if (caption.length > 0) return handleNewProduct(chatId, message, caption);
      sendTelegramWithKeyboard(chatId, "📸 Надішли фото з підписом:\n`Назва UA | Назва EN | Ціна`", MAIN_KEYBOARD);
      return successStub();
    }

    // --- Документ + /manual ---
    if (message.document && text.startsWith("/manual")) {
      return handleManual(chatId, message);
    }

    // --- Перевірка стейту (чекаємо введення) ---
    var state = getBotState(chatId);
    if (state) {
      return handleStateInput(chatId, text, state);
    }

    // --- Фіксовані кнопки внизу ---
    if (text === "📦 Товари") return showProductsMenu(chatId);
    if (text === "📋 Замовлення") return showOrdersMenu(chatId);
    if (text === "❓ Допомога") return showFullHelp(chatId);

    // --- Команди (fallback) ---
    if (text === "/start" || text === "/help") return showMainMenu(chatId);
    if (text.startsWith("/")) {
      sendTelegramWithKeyboard(chatId, "Використовуй кнопки меню 👇", MAIN_KEYBOARD);
      return successStub();
    }

    sendTelegramWithKeyboard(chatId, "Використовуй кнопки меню 👇", MAIN_KEYBOARD);
    return successStub();

  } catch (error) {
    writeLog("BOT ERROR", error.toString());
    return successStub();
  }
}

// --- Обробка введення коли є активний стейт ---
function handleStateInput(chatId, text, state) {
  if (text === "❌ Скасувати" || text === "/cancel") {
    clearBotState(chatId);
    sendTelegramWithKeyboard(chatId, "✅ Скасовано", MAIN_KEYBOARD);
    return successStub();
  }

  if (state.action === "awaiting_price") {
    var price = parseFloat(text);
    if (isNaN(price) || price <= 0) {
      sendTelegramReply(chatId, "❌ Введіть коректну ціну (число). Спробуйте ще:");
      return successStub();
    }
    var products = supabaseGetProducts();
    for (var i = 0; i < products.length; i++) {
      if (products[i].id === state.productId) {
        products[i].price = price;
        break;
      }
    }
    supabaseUpdateProducts(products);
    clearBotState(chatId);
    sendTelegramWithKeyboard(chatId, "✅ Ціну товару #" + state.productId + " змінено на $" + price, MAIN_KEYBOARD);
    return successStub();
  }

  if (state.action === "awaiting_options") {
    // Формат: назва1:ціна1;назва2:ціна2
    var products = supabaseGetProducts();
    var product = null;
    for (var i = 0; i < products.length; i++) {
      if (products[i].id === state.productId) { product = products[i]; break; }
    }
    if (!product) { clearBotState(chatId); return successStub(); }
    var optParts = text.split(";");
    product.options = [];
    for (var j = 0; j < optParts.length; j++) {
      var kv = optParts[j].split(":");
      if (kv.length >= 2) {
        product.options.push({ name: { ua: kv[0].trim(), en: kv[0].trim() }, price: parseFloat(kv[1].trim()) || 0 });
      }
    }
    supabaseUpdateProducts(products);
    clearBotState(chatId);
    sendTelegramWithKeyboard(chatId, "✅ Опції товару #" + state.productId + " оновлено (" + product.options.length + " шт.)", MAIN_KEYBOARD);
    return successStub();
  }

  if (state.action === "awaiting_new_product_caption") {
    // Зберігаємо підпис, чекаємо фото
    var parts = text.split("|").map(function(s) { return s.trim(); });
    if (parts.length < 3) {
      sendTelegramReply(chatId, "❌ Формат: `Назва UA | Назва EN | Ціна`\nМожна додати опис: `Назва UA | Назва EN | Ціна | Опис UA | Опис EN`");
      return successStub();
    }
    setBotState(chatId, { action: "awaiting_new_product_photo", caption: text });
    sendTelegramReply(chatId, "📸 Тепер надішли фото товару:");
    return successStub();
  }

  clearBotState(chatId);
  sendTelegramWithKeyboard(chatId, "❓ Не зрозумів. Використовуй кнопки меню 👇", MAIN_KEYBOARD);
  return successStub();
}

// --- Додати товар: отримали фото після підпису ---
function handleNewProductPhoto(chatId, message, state) {
  var caption = state.caption || "";
  clearBotState(chatId);
  return handleNewProduct(chatId, message, caption);
}

// --- Додати фото до товару по стейту ---
function handleAddPhotoByState(chatId, message, state) {
  var products = supabaseGetProducts();
  var product = null;
  for (var i = 0; i < products.length; i++) {
    if (products[i].id === state.productId) { product = products[i]; break; }
  }
  if (!product) { clearBotState(chatId); sendTelegramReply(chatId, "❌ Товар не знайдено"); return successStub(); }

  var fileId = message.photo[message.photo.length - 1].file_id;
  var photoNum = product.images.length + 1;
  var filename = "product-" + state.productId + "-" + photoNum + ".jpg";
  var imageUrl = uploadTelegramPhotoToSupabase(fileId, filename);
