var GITHUB_REPO = "Dimonlipko/Dimonlipko.github.io";
var PRODUCTS_PATH = "products.json";
var IMAGES_DIR = "img/products/";

function getGithubHeaders() {
  var token = PropertiesService.getScriptProperties().getProperty('GITHUB_TOKEN');
  return {
    "Authorization": "token " + token,
    "Accept": "application/vnd.github.v3+json",
    "User-Agent": "EE-Bot"
  };
}

function githubGetFile(path) {
  var url = "https://api.github.com/repos/" + GITHUB_REPO + "/contents/" + path;
  var response = UrlFetchApp.fetch(url, {
    method: "GET",
    headers: getGithubHeaders(),
    muteHttpExceptions: true
  });
  if (response.getResponseCode() === 200) {
    return JSON.parse(response.getContentText());
  }
  return null;
}

function githubPutFile(path, contentBase64, sha, commitMessage) {
  var url = "https://api.github.com/repos/" + GITHUB_REPO + "/contents/" + path;
  var payload = {
    message: commitMessage,
    content: contentBase64
  };
  if (sha) payload.sha = sha;

  var response = UrlFetchApp.fetch(url, {
    method: "PUT",
    headers: getGithubHeaders(),
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });
  return response.getResponseCode() === 200 || response.getResponseCode() === 201;
}

function githubGetProducts() {
  var file = githubGetFile(PRODUCTS_PATH);
  if (!file) return [];
  var content = Utilities.newBlob(Utilities.base64Decode(file.content)).getDataAsString();
  return JSON.parse(content);
}

function githubUpdateProducts(products) {
  var file = githubGetFile(PRODUCTS_PATH);
  var sha = file ? file.sha : null;
  var json = JSON.stringify(products, null, 2);
  var base64 = Utilities.base64Encode(Utilities.newBlob(json).getBytes());
  return githubPutFile(PRODUCTS_PATH, base64, sha, "Update products via Telegram bot");
}

function uploadTelegramPhotoToGithub(fileId, filename) {
  var token = PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');

  // Отримати file_path
  var fileInfo = UrlFetchApp.fetch("https://api.telegram.org/bot" + token + "/getFile?file_id=" + fileId);
  var filePath = JSON.parse(fileInfo.getContentText()).result.file_path;

  // Завантажити blob
  var fileBlob = UrlFetchApp.fetch("https://api.telegram.org/file/bot" + token + "/" + filePath);
  var bytes = fileBlob.getBlob().getBytes();
  var base64 = Utilities.base64Encode(bytes);

  // Завантажити на GitHub
  var path = IMAGES_DIR + filename;
  var success = githubPutFile(path, base64, null, "Add product image: " + filename);

  if (success) {
    return "/" + path; // відносний URL для сайту
  }
  return null;
}

function sendTelegramReply(chatId, text) {
  var token = PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');
  var url = "https://api.telegram.org/bot" + token + "/sendMessage";
  var payload = { chat_id: chatId, text: text, parse_mode: "Markdown" };
  UrlFetchApp.fetch(url, {
    method: "POST",
    contentType: "application/json",
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });
}

