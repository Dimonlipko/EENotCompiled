// --- Змінити ціну ---
function handlePrice(chatId, text) {
  // /price ID PRICE
  var parts = text.split(/\s+/);
  var id = parseInt(parts[1]);
  var newPrice = parseFloat(parts[2]);
  if (!id || isNaN(newPrice)) {
    sendTelegramReply(chatId, "❌ Формат: /price ID ЦІНА");
    return successStub();
  }

  var products = supabaseGetProducts();
  var found = false;
  for (var i = 0; i < products.length; i++) {
    if (products[i].id === id) {
      products[i].price = newPrice;
      found = true;
      break;
    }
  }
  if (!found) {
    sendTelegramReply(chatId, "❌ Товар #" + id + " не знайдено.");
    return successStub();
  }

  var updateResult = supabaseUpdateProducts(products);
  sendTelegramReply(chatId, "✅ Ціну товару #" + id + " змінено на $" + newPrice + " (save: " + updateResult + ")");
  return successStub();
}

