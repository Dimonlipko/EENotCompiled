// === POST — Замовлення, контакти та Telegram webhook ===
function doPost(e) {
  try {
    if (!e.postData || !e.postData.contents) throw new Error("No data received");

    const data = JSON.parse(e.postData.contents);

    // --- TELEGRAM WEBHOOK ---
    if (data.update_id !== undefined) {
      if (data.message) {
        try { handleTelegramWebhook(data); } catch(ex) {}
      }
      return HtmlService.createHtmlOutput();
    }

    // --- Замовлення/контакти — з lock і логуванням ---
    var lock = LockService.getScriptLock();
    lock.tryLock(10000);

    var rawData = e.postData.contents;
    writeLog("INFO", "Вхідний запит: " + rawData);

    // --- 🛡️ АНТИ-СПАМ (Honeypot & Time) ---
    if (data.honeypot && data.honeypot.length > 0) {
      writeLog("WARN", "SPAM DETECTED: Honeypot filled. IP: " + (data.ip || "Unknown"));
      return successStub();
    }
    
    // Перевірка часу (якщо прийшло timeTaken)
    if (data.timeTaken && data.timeTaken < 2000) {
      writeLog("WARN", "SPAM DETECTED: Too fast (" + data.timeTaken + "ms). IP: " + (data.ip || "Unknown"));
      return successStub();
    }

    // --- 🛡️ КЕШУВАННЯ (Дублікати) ---
    // Якщо IP немає, використовуємо тільки телефон як ідентифікатор
    const ipLabel = data.ip && data.ip !== 'Unknown' ? data.ip : "NoIP";
    const userIdentifier = (data.phone || "NoPhone") + "_" + ipLabel;
    
    const cache = CacheService.getScriptCache();
    const isDuplicate = cache.get(userIdentifier);
    
    if (isDuplicate) {
      writeLog("WARN", "DUPLICATE BLOCKED: " + userIdentifier);
      return successStub(); 
    }
    
    // Блокуємо повтори на 180 секунд
    cache.put(userIdentifier, "true", 180);

    // --- ВАЛІДАЦІЯ ---
    if (!data.phone || !data.name || data.name.length < 1) {
       writeLog("ERROR", "VALIDATION FAILED: No name or phone");
       return ContentService.createTextOutput(JSON.stringify({status: "error", message: "Invalid data"}))
         .setMimeType(ContentService.MimeType.JSON);
    }

    // Валідація email
    if (data.email && !/^.+@.+\..+$/.test(data.email)) {
      writeLog("WARN", "INVALID EMAIL: " + data.email + " IP: " + (data.ip || "Unknown"));
      return ContentService.createTextOutput(JSON.stringify({status: "error", message: "Invalid email"}))
        .setMimeType(ContentService.MimeType.JSON);
    }

    // Валідація телефону (мінімум 9 цифр)
    var phoneDigits = (data.phone || "").replace(/[^\d]/g, "");
    if (phoneDigits.length < 9) {
      writeLog("WARN", "INVALID PHONE: " + data.phone + " IP: " + (data.ip || "Unknown"));
      return ContentService.createTextOutput(JSON.stringify({status: "error", message: "Invalid phone"}))
        .setMimeType(ContentService.MimeType.JSON);
    }

    // --- 🛡️ RATE LIMIT за IP/добу (макс 5 запитів за 24 години) ---
    if (data.ip && data.ip !== 'Unknown') {
      var rateLimitKey = "rate_" + data.ip;
      var requestCount = cache.get(rateLimitKey);
      var count = requestCount ? parseInt(requestCount) : 0;
      if (count >= 5) {
        writeLog("WARN", "RATE LIMIT EXCEEDED: " + data.ip + " (" + count + " requests)");
        return successStub();
      }
      cache.put(rateLimitKey, String(count + 1), 86400);
    }

    // --- 🛡️ URL-СПАМ ФІЛЬТР (3+ посилань = спам) ---
    var messageText = data.message || "";
    var urlCount = (messageText.match(/https?:\/\//gi) || []).length;
    if (urlCount >= 3) {
      writeLog("WARN", "URL SPAM DETECTED: " + urlCount + " URLs. IP: " + (data.ip || "Unknown"));
      return successStub();
    }

    // --- САНІТИЗАЦІЯ (видалення HTML/script тегів) ---
    if (data.name) data.name = data.name.replace(/<[^>]*>/g, "");
    if (data.message) data.message = data.message.replace(/<[^>]*>/g, "");

    // --- РОЗРІЗНЕННЯ ЗА ТИПОМ ---
    if (data.type === "contact") {
      // === КОНТАКТНЕ ПОВІДОМЛЕННЯ ===
      const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Контакти");
      if (!sheet) throw new Error("Аркуш 'Контакти' не знайдено");

      const newRow = [
        new Date(),
        data.name,
        data.phone,
        data.email || "—",
        data.message || "—",
        data.ip || "Не визначено"
      ];

      sheet.appendRow(newRow);
      writeLog("SUCCESS", "Contact saved for: " + data.email);

      const telegramMessage = `📩 *Нове повідомлення!*\n` +
                              `👤 ${data.name}\n📞 ${data.phone}\n` +
                              `✉️ ${data.email || "—"}\n\n` +
                              `💬 ${data.message || "—"}\n` +
                              `📍 IP: ${data.ip || "N/A"}`;

      sendTelegramMessage(telegramMessage);

    } else {
      // === ЗАМОВЛЕННЯ ===
      const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Лист1");
      if (!sheet) throw new Error("Аркуш 'Лист1' не знайдено");

      const productsInfo = data.products ? data.products.map(p => `${p.title} (${p.quantity})`).join("\n") : "";

      const newRow = [
        new Date(),
        data.name,
        data.phone,
        data.email || "—",
        productsInfo,
        data.country || "—",
        data.total || 0,
        data.ip || "Не визначено"
      ];

      sheet.appendRow(newRow);
      writeLog("SUCCESS", "Order saved for: " + data.email);

      const telegramMessage = `⚡️ *Нове замовлення!*\n` +
                              `👤 ${data.name}\n📞 ${data.phone}\n` +
                              `💰 ${data.total} $\n` +
                              `📍 IP: ${data.ip || "N/A"}\n\n` +
                              `🛒 ${productsInfo}`;

      sendTelegramMessage(telegramMessage);
    }

    return successStub();

  } catch (error) {
    writeLog("CRITICAL ERROR", error.toString());
    return ContentService.createTextOutput(JSON.stringify({status: "error", message: error.toString()}))
      .setMimeType(ContentService.MimeType.JSON);
  } finally {
    try { lock.releaseLock(); } catch(ex) {}
  }
}

// --- ДОПОМІЖНІ ФУНКЦІЇ ---

function successStub() {
  return ContentService.createTextOutput(JSON.stringify({status: "success"}))
      .setMimeType(ContentService.MimeType.JSON);
}

// Функція для запису в вкладку Logs
function writeLog(level, message) {
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Logs");
    if (sheet) {
      // Додаємо рядок: Час | Рівень | Повідомлення
      sheet.appendRow([new Date(), level, message]);
    } else {
      // Якщо вкладки немає, пишемо в консоль Google
      Logger.log("TAB 'Logs' NOT FOUND! " + level + ": " + message);
    }
  } catch (e) {
    Logger.log("LOGGING FAILED: " + e.toString());
  }
}

function sendTelegramMessage(text) {
  const scriptProps = PropertiesService.getScriptProperties();
  const token = scriptProps.getProperty('TELEGRAM_TOKEN'); 
  const chatId = scriptProps.getProperty('CHAT_ID');

  if (!token || !chatId) {
    writeLog("ERROR", "Telegram token or Chat ID missing");
    return;
  }

  const url = `https://api.telegram.org/bot${token}/sendMessage`;
  const payload = { chat_id: chatId, text: text, parse_mode: "Markdown" };
  const options = { method: "POST", contentType: "application/json", payload: JSON.stringify(payload), muteHttpExceptions: true };

  try {
    var response = UrlFetchApp.fetch(url, options);
    var respCode = response.getResponseCode();
    if (respCode !== 200) {
       writeLog("TELEGRAM ERROR", "Response code: " + respCode + ". Body: " + response.getContentText());
    }
  } catch (error) {
    writeLog("TELEGRAM EXCEPTION", error.toString());
  }
}

// ============================================================
// === TELEGRAM BOT — КЕРУВАННЯ МАГАЗИНОМ ===
// ============================================================

function handleTelegramWebhook(update) {
  try {
    const message = update.message;
    if (!message) return successStub();

    // Ігнорувати повідомлення від ботів (захист від зациклення)
    if (message.from && message.from.is_bot) return;

    const chatId = String(message.chat.id);
    const adminChatId = String(PropertiesService.getScriptProperties().getProperty('CHAT_ID')).trim();

    // Тільки адмін може керувати
    if (chatId !== adminChatId) {
      writeLog("BOT", "ACCESS DENIED: chatId=" + chatId + " adminChatId=" + adminChatId);
      return successStub();
    }

    const text = message.text || message.caption || "";

    // Фото + підпис = додати товар
    if (message.photo && message.photo.length > 0) {
      const caption = message.caption || "";
      if (caption.startsWith("/addphoto")) {
        return handleAddPhoto(chatId, message, caption);
      }
      return handleNewProduct(chatId, message, caption);
    }

    // Текстові команди
    if (text.startsWith("/list")) return handleList(chatId);
    if (text.startsWith("/price")) return handlePrice(chatId, text);
    if (text.startsWith("/delete")) return handleDelete(chatId, text);
    if (text.startsWith("/restore")) return handleRestore(chatId, text);
    if (text.startsWith("/options")) return handleOptions(chatId, text);
    if (text.startsWith("/help") || text.startsWith("/start")) return handleHelp(chatId);

    sendTelegramReply(chatId, "❓ Невідома команда. Надішли /help");
    return successStub();

  } catch (error) {
    writeLog("BOT ERROR", error.toString());
    return successStub();
  }
}

// --- Додати товар (фото + підпис) ---
function handleNewProduct(chatId, message, caption) {
  // Формат: Title_UA | Title_EN | Price | Desc_UA | Desc_EN
  var parts = caption.split("|").map(function(s) { return s.trim(); });
  if (parts.length < 3) {
    sendTelegramReply(chatId, "❌ Формат: Title_UA | Title_EN | Price | Desc_UA | Desc_EN");
    return successStub();
  }

  var titleUA = parts[0];
  var titleEN = parts[1] || titleUA;
  var price = parseFloat(parts[2]) || 0;
  var descUA = parts[3] || "";
  var descEN = parts[4] || descUA;

  // Завантажити фото
  var fileId = message.photo[message.photo.length - 1].file_id; // найбільша якість
  var products = githubGetProducts();
  var newId = 1;
  for (var i = 0; i < products.length; i++) {
    if (products[i].id >= newId) newId = products[i].id + 1;
  }

  var filename = "product-" + newId + "-1.jpg";
  var imageUrl = uploadTelegramPhotoToGithub(fileId, filename);

  if (!imageUrl) {
    sendTelegramReply(chatId, "❌ Помилка завантаження фото.");
    return successStub();
  }

  var newProduct = {
    id: newId,
    title: { ua: titleUA, en: titleEN },
    price: price,
    images: [imageUrl],
    description: { ua: descUA, en: descEN },
    options: []
  };

  products.push(newProduct);
  githubUpdateProducts(products);

  sendTelegramReply(chatId, "✅ Товар #" + newId + " додано!\n" + titleUA + " — $" + price);
  return successStub();
}

// --- Додати фото до існуючого товару ---
function handleAddPhoto(chatId, message, caption) {
  // /addphoto ID
  var parts = caption.split(/\s+/);
  var id = parseInt(parts[1]);
  if (!id) {
    sendTelegramReply(chatId, "❌ Формат: /addphoto ID (надішли з фото)");
    return successStub();
  }

  var products = githubGetProducts();
  var product = null;
  for (var i = 0; i < products.length; i++) {
    if (products[i].id === id) { product = products[i]; break; }
  }
  if (!product) {
    sendTelegramReply(chatId, "❌ Товар #" + id + " не знайдено.");
    return successStub();
  }

  var fileId = message.photo[message.photo.length - 1].file_id;
  var photoNum = product.images.length + 1;
  var filename = "product-" + id + "-" + photoNum + ".jpg";
  var imageUrl = uploadTelegramPhotoToGithub(fileId, filename);

  if (!imageUrl) {
    sendTelegramReply(chatId, "❌ Помилка завантаження фото.");
    return successStub();
  }

  product.images.push(imageUrl);
  githubUpdateProducts(products);

  sendTelegramReply(chatId, "✅ Фото додано до товару #" + id + " (всього: " + product.images.length + ")");
  return successStub();
}

// --- Список товарів ---
function handleList(chatId) {
  var products = githubGetProducts();
  if (products.length === 0) {
    sendTelegramReply(chatId, "📦 Магазин порожній.");
    return successStub();
  }
  var text = "📦 *Товари:*\n\n";
  for (var i = 0; i < products.length; i++) {
    var p = products[i];
    text += "#" + p.id + " — " + p.title.ua + " — $" + p.price;
    if (p.options && p.options.length > 0) text += " ⚙️";
    text += "\n";
  }
  sendTelegramReply(chatId, text);
  return successStub();
}

// --- Змінити ціну ---
function handlePrice(chatId, text) {
  // /price ID PRICE
  var parts = text.split(/\s+/);
  var id = parseInt(parts[1]);
  var newPrice = parseFloat(parts[2]);
  if (!id || isNaN(newPrice)) {
    sendTelegramReply(chatId, "❌ Формат: /price ID ЦІНА");
    return successStub();
  }

  var products = githubGetProducts();
  var found = false;
  for (var i = 0; i < products.length; i++) {
    if (products[i].id === id) {
      products[i].price = newPrice;
      found = true;
      break;
    }
  }
  if (!found) {
    sendTelegramReply(chatId, "❌ Товар #" + id + " не знайдено.");
    return successStub();
  }

  githubUpdateProducts(products);
  sendTelegramReply(chatId, "✅ Ціну товару #" + id + " змінено на $" + newPrice);
  return successStub();
}

// --- Видалити товар ---
function handleDelete(chatId, text) {
  var parts = text.split(/\s+/);
  var id = parseInt(parts[1]);
  if (!id) {
    sendTelegramReply(chatId, "❌ Формат: /delete ID");
    return successStub();
  }

  var products = githubGetProducts();
  var newProducts = products.filter(function(p) { return p.id !== id; });
  if (newProducts.length === products.length) {
    sendTelegramReply(chatId, "❌ Товар #" + id + " не знайдено.");
    return successStub();
  }

  githubUpdateProducts(newProducts);
  sendTelegramReply(chatId, "🗑 Товар #" + id + " видалено.");
  return successStub();
}

// --- Відновити товар (не реалізовано — товар видаляється повністю) ---
function handleRestore(chatId, text) {
  sendTelegramReply(chatId, "ℹ️ Видалені товари не зберігаються. Додайте товар заново.");
  return successStub();
}

// --- Додати опції ---
function handleOptions(chatId, text) {
  // /options ID опція1:ціна1;опція2:ціна2
  var match = text.match(/^\/options\s+(\d+)\s+(.+)$/);
  if (!match) {
    sendTelegramReply(chatId, "❌ Формат: /options ID назва1:ціна1;назва2:ціна2");
    return successStub();
  }

  var id = parseInt(match[1]);
  var optionsStr = match[2];

  var products = githubGetProducts();
  var product = null;
  for (var i = 0; i < products.length; i++) {
    if (products[i].id === id) { product = products[i]; break; }
  }
  if (!product) {
    sendTelegramReply(chatId, "❌ Товар #" + id + " не знайдено.");
    return successStub();
  }

  var optParts = optionsStr.split(";");
  product.options = [];
  for (var j = 0; j < optParts.length; j++) {
    var kv = optParts[j].split(":");
    if (kv.length >= 2) {
      product.options.push({
        name: { ua: kv[0].trim(), en: kv[0].trim() },
        price: parseFloat(kv[1].trim()) || 0
      });
    }
  }

  githubUpdateProducts(products);
  sendTelegramReply(chatId, "✅ Опції товару #" + id + " оновлено (" + product.options.length + " шт.)");
  return successStub();
}

// --- Допомога ---
function handleHelp(chatId) {
  var text = "🤖 *Команди бота:*\n\n" +
    "📸 *Фото + підпис* — додати товар\n" +
    "Формат: `Title_UA | Title_EN | Price | Desc_UA | Desc_EN`\n\n" +
    "📸 *Фото + /addphoto ID* — додати фото до товару\n\n" +
    "📋 /list — список товарів\n" +
    "💰 /price ID ЦІНА — змінити ціну\n" +
    "🗑 /delete ID — видалити товар\n" +
    "⚙️ /options ID назва1:ціна1;назва2:ціна2 — додати опції\n" +
    "❓ /help — ця довідка";
  sendTelegramReply(chatId, text);
  return successStub();
}

