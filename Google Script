// --- Додати опції ---
function handleOptions(chatId, text) {
  // /options ID опція1:ціна1;опція2:ціна2
  var match = text.match(/^\/options\s+(\d+)\s+(.+)$/);
  if (!match) {
    sendTelegramReply(chatId, "❌ Формат: /options ID назва1:ціна1;назва2:ціна2");
    return successStub();
  }

  var id = parseInt(match[1]);
  var optionsStr = match[2];

  var products = supabaseGetProducts();
  var product = null;
  for (var i = 0; i < products.length; i++) {
    if (products[i].id === id) { product = products[i]; break; }
  }
  if (!product) {
    sendTelegramReply(chatId, "❌ Товар #" + id + " не знайдено.");
    return successStub();
  }

  var optParts = optionsStr.split(";");
  product.options = [];
  for (var j = 0; j < optParts.length; j++) {
    var kv = optParts[j].split(":");
    if (kv.length >= 2) {
      product.options.push({
        name: { ua: kv[0].trim(), en: kv[0].trim() },
        price: parseFloat(kv[1].trim()) || 0
      });
    }
  }

  supabaseUpdateProducts(products);
  sendTelegramReply(chatId, "✅ Опції товару #" + id + " оновлено (" + product.options.length + " шт.)");
  return successStub();
}

// --- Оновити мануал (PDF через GitHub API) ---
function handleManual(chatId, message) {
  var doc = message.document;
  if (!doc.file_name.endsWith('.pdf')) {
    sendTelegramReply(chatId, "❌ Потрібен PDF файл");
    return successStub();
  }

  var token = PropertiesService.getScriptProperties().getProperty('TELEGRAM_TOKEN');
  var fileInfo = UrlFetchApp.fetch("https://api.telegram.org/bot" + token + "/getFile?file_id=" + doc.file_id);
  var filePath = JSON.parse(fileInfo.getContentText()).result.file_path;
  var fileBlob = UrlFetchApp.fetch("https://api.telegram.org/file/bot" + token + "/" + filePath);
  var bytes = fileBlob.getBlob().getBytes();
  var base64 = Utilities.base64Encode(bytes);

  var githubToken = PropertiesService.getScriptProperties().getProperty('GITHUB_TOKEN');
  var path = "docs/Leaf_ecu_manual.pdf";
  var headers = {"Authorization": "token " + githubToken, "User-Agent": "EE-Bot"};

  var existingFile = UrlFetchApp.fetch("https://api.github.com/repos/Dimonlipko/Dimonlipko.github.io/contents/" + path, {
    headers: headers, muteHttpExceptions: true
  });
  var sha = null;
  if (existingFile.getResponseCode() === 200) {
    sha = JSON.parse(existingFile.getContentText()).sha;
  }

  var payload = { message: "Update manual via Telegram bot", content: base64 };
  if (sha) payload.sha = sha;

  var response = UrlFetchApp.fetch("https://api.github.com/repos/Dimonlipko/Dimonlipko.github.io/contents/" + path, {
    method: "PUT",
    headers: {"Authorization": "token " + githubToken, "User-Agent": "EE-Bot", "Content-Type": "application/json"},
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });

  if (response.getResponseCode() === 200 || response.getResponseCode() === 201) {
    sendTelegramReply(chatId, "✅ Мануал оновлено!\nhttps://electricengines.com.ua/docs/Leaf_ecu_manual.pdf");
  } else {
    sendTelegramReply(chatId, "❌ Помилка: " + response.getResponseCode());
  }
  return successStub();
}

